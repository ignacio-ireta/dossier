# System dependencies for dossier on macOS. Install with:
#   brew bundle --file Brewfile
# dossier itself is a Python package installed with `uv tool install`.

brew "uv"            # Python package manager (installs dossier)
brew "ffmpeg"        # audio/video normalization for meetings
brew "pandoc"        # Markdown -> DOCX/PDF rendering
brew "typst"         # PDF engine for pandoc
brew "mermaid-cli"   # Mermaid diagrams (mmdc)
brew "ollama"        # local model server (chat + embeddings)
brew "bun"           # runtime for the optional qmd search backend

cask "drawio"        # draw.io diagram export
cask "libreoffice"   # DOCX -> PDF fidelity path, slide rendering, TOC page numbers
